{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "My librs app",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "This is a documentation of my librs app"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    },
    {
      "url": "https://example.com/api/v1"
    }
  ],
  "tags": [
    {
      "name": "Librs",
      "description": "Operations about librs."
    },
    {
      "name": "Auth",
      "description": "Auth operations."
    }
  ],
  "paths": {
    "/librs": {
      "get": {
        "tags": [
          "Librs"
        ],
        "summary": "Get list of librs",
        "operationId": "getLibrs",
        "description": "Get list of librs with this endpoint",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "example": 1
            }
          },
          {
            "in": "query",
            "name": "perPage",
            "schema": {
              "type": "integer",
              "example": 10
            }
          },
          {
            "in": "query",
            "name": "sortBy",
            "schema": {
              "type": "string",
              "example": "title"
            },
            "description": "All librs's fields can be mentioned. Default value - _id"
          },
          {
            "in": "query",
            "name": "sortOrder",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ],
              "example": "asc"
            }
          },
          {
            "in": "query",
            "name": "minTotalPage",
            "schema": {
              "type": "number",
              "example": 4
            }
          },
          {
            "in": "query",
            "name": "maxTotalPage",
            "schema": {
              "type": "number",
              "example": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully found librs!",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found students!"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "items",
                        "page",
                        "perPage",
                        "totalItems",
                        "totalPages",
                        "hasNextPage",
                        "hasPrevPage"
                      ],
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/libr"
                          }
                        },
                        "page": {
                          "type": "number",
                          "example": 2
                        },
                        "perPage": {
                          "type": "number",
                          "example": 4
                        },
                        "totalItems": {
                          "type": "number",
                          "example": 4
                        },
                        "totalPages": {
                          "type": "number",
                          "example": 4
                        },
                        "hasNextPage": {
                          "type": "boolean",
                          "example": false
                        },
                        "hasPrevPage": {
                          "type": "boolean",
                          "example": true
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      },
      "post": {
        "tags": [
          "Librs"
        ],
        "summary": "Create libr",
        "operationId": "createLibr",
        "description": "Create a libr with payload",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "total_page",
                  "year"
                ],
                "properties": {
                  "title": {
                    "description": "Libr's name",
                    "type": "string",
                    "example": "Kolobok"
                  },
                  "total_page": {
                    "description": "Libr's total page",
                    "type": "number",
                    "example": 12
                  },
                  "genre": {
                    "description": "Libr's genre",
                    "type": "string",
                    "enum": [
                      "kids",
                      "roman",
                      "adventures"
                    ]
                  },
                  "year": {
                    "description": "Libr's production year",
                    "type": "number",
                    "example": 1960
                  },
                  "posterUrl": {
                    "description": "Libr's poster",
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Creates a libr",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 201
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully add libr"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/libr"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      }
    },
    "/librs/{id}": {
      "get": {
        "tags": [
          "Librs"
        ],
        "summary": "Get libr by id",
        "operationId": "getLibr",
        "description": "Get libr by id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "65ca67e7ae7f10c88b598384"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get libr by id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully find libr with id=65ca67e7ae7f10c88b598384!"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/libr"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "libr": {
        "type": "object",
        "required": [
          "_id",
          "title",
          "genre",
          "total_page",
          "year",
          "userId"
        ],
        "properties": {
          "_id": {
            "description": "Libr's id",
            "type": "string",
            "example": "65e4decdd286b30065d54af9"
          },
          "title": {
            "description": "Libr's title",
            "type": "string",
            "example": "Kolobok"
          },
          "genre": {
            "description": "Libr's genre",
            "type": "string",
            "enum": [
              "kids",
              "roman",
              "adventures"
            ]
          },
          "total_page": {
            "description": "Libr's total page",
            "type": "number",
            "example": 90
          },
          "year": {
            "description": "Libr's production year",
            "type": "number",
            "example": 1960
          },
          "userId": {
            "description": "Libr's user id",
            "type": "string",
            "example": "65e4decdd286b30065d54af9"
          },
          "posterUrl": {
            "description": "Link to libr's poster",
            "type": "string",
            "example": "https://res.cloudinary.com/uqwgdu/image/upload/image.png"
          }
        }
      }
    },
    "responses": {
      "401": {
        "description": "Unauthorized error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "status",
                "message"
              ],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 401
                },
                "message": {
                  "type": "string",
                  "example": "Authorization header missing"
                }
              }
            }
          }
        }
      }
    }
  }
}